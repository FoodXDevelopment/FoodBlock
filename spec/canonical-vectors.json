{
  "comment": "Adversarial conformance vectors for the canonical form (canonical.md): RFC 8785 plus strict writing. A conforming implementation reproduces every canonical string and hash exactly and refuses every `refused` block with the codes given (the strict check finds them, in the order of core.md section 8). Keys sort by UTF-16 code units; nothing is sorted, dropped or normalised on the way in.",
  "vectors": [
    { "name": "key order is meaningless",
      "block": { "type": "thing", "state": { "b": 1, "a": 2 }, "refs": {} },
      "same_as": { "type": "thing", "state": { "a": 2, "b": 1 }, "refs": {} } },
    { "name": "integers are plain digits",
      "block": { "type": "thing", "state": { "n": 100, "m": -7 }, "refs": {} },
      "canonical_contains": "\"m\":-7,\"n\":100" },
    { "name": "a composed and a decomposed é are different bytes: the decomposed one is refused, never repaired",
      "block": { "type": "thing", "state": { "s": "café" }, "refs": {} },
      "not_same_as": { "type": "thing", "state": { "s": "café" }, "refs": {} },
      "refused": ["not_canonical"] },
    { "name": "emoji and astral characters survive",
      "block": { "type": "thing", "state": { "s": "🍞 sourdough" }, "refs": {} },
      "canonical_contains": "🍞 sourdough" },
    { "name": "a set under refs is written sorted; written unsorted it is refused, not sorted",
      "block": { "type": "thing", "state": {}, "refs": { "sees": ["b2", "a1"] } },
      "not_same_as": { "type": "thing", "state": {}, "refs": { "sees": ["a1", "b2"] } },
      "canonical_contains": "\"sees\":[\"b2\",\"a1\"]" },
    { "name": "state arrays are sequences (order preserved)",
      "block": { "type": "thing", "state": { "steps": ["knead", "bake"] }, "refs": {} },
      "not_same_as": { "type": "thing", "state": { "steps": ["bake", "knead"] }, "refs": {} } },
    { "name": "a null is written as null and refused",
      "block": { "type": "thing", "state": { "a": 1, "gone": null }, "refs": {} },
      "not_same_as": { "type": "thing", "state": { "a": 1 }, "refs": {} },
      "refused": ["not_canonical"] },
    { "name": "a float is refused",
      "block": { "type": "thing", "state": { "n": 1.5 }, "refs": {} },
      "refused": ["float"] },
    { "name": "at is inside the identity of a claim",
      "block": { "type": "thing", "state": { "a": 1, "at": "2026-07-07T15:00:00.000Z" }, "refs": {} },
      "not_same_as": { "type": "thing", "state": { "a": 1, "at": "2026-07-07T15:00:01.000Z" }, "refs": {} } },
    { "name": "UTF-16 order, not code-point order: the emoji before the full-width tilde",
      "block": { "type": "thing", "state": { "～": 2, "😀": 1 }, "refs": {} },
      "canonical": "{\"refs\":{},\"state\":{\"😀\":1,\"～\":2},\"type\":\"thing\"}" }
  ]
}
