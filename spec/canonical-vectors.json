{
  "comment": "Adversarial conformance vectors for the canonical form (canonical.md): RFC 8785 plus strict writing. A conforming implementation reproduces every canonical string and hash exactly and refuses every `refused` block with the codes given (the strict check finds them, in the order of core.md section 8). Keys sort by the bytes of their UTF-8 form (code-point order); nothing is sorted, dropped or normalised on the way in.",
  "vectors": [
    { "name": "key order is meaningless",
      "block": { "type": "thing", "state": { "b": 1, "a": 2 }, "refs": {} },
      "same_as": { "type": "thing", "state": { "a": 2, "b": 1 }, "refs": {} } },
    { "name": "integers are plain digits",
      "block": { "type": "thing", "state": { "n": 100, "m": -7 }, "refs": {} },
      "canonical_contains": "\"m\":-7,\"n\":100" },
    { "name": "a composed and a decomposed é are different bytes: each is written as it is, never normalised or refused (canonical.md: text is compared byte for byte)",
      "block": { "type": "thing", "state": { "s": "café" }, "refs": {} },
      "not_same_as": { "type": "thing", "state": { "s": "café" }, "refs": {} } },
    { "name": "emoji and astral characters survive",
      "block": { "type": "thing", "state": { "s": "🍞 sourdough" }, "refs": {} },
      "canonical_contains": "🍞 sourdough" },
    { "name": "a set under refs is written sorted; written unsorted it is refused, not sorted",
      "block": { "type": "thing", "state": {}, "refs": { "sees": ["b2", "a1"] } },
      "not_same_as": { "type": "thing", "state": {}, "refs": { "sees": ["a1", "b2"] } },
      "canonical_contains": "\"sees\":[\"b2\",\"a1\"]" },
    { "name": "state arrays are sequences (order preserved)",
      "block": { "type": "thing", "state": { "steps": ["knead", "bake"] }, "refs": {} },
      "not_same_as": { "type": "thing", "state": { "steps": ["bake", "knead"] }, "refs": {} } },
    { "name": "a null is written as null and refused",
      "block": { "type": "thing", "state": { "a": 1, "gone": null }, "refs": {} },
      "not_same_as": { "type": "thing", "state": { "a": 1 }, "refs": {} },
      "refused": ["not_canonical"] },
    { "name": "a float is refused",
      "block": { "type": "thing", "state": { "n": 1.5 }, "refs": {} },
      "refused": ["float"] },
    { "name": "at is inside the identity of a claim",
      "block": { "type": "thing", "state": { "a": 1, "at": "2026-07-07T15:00:00.000Z" }, "refs": {} },
      "not_same_as": { "type": "thing", "state": { "a": 1, "at": "2026-07-07T15:00:01.000Z" }, "refs": {} } },
    { "name": "UTF-8 byte order (code-point order), not UTF-16 order: the full-width tilde (U+FF5E) before the emoji (U+1F600)",
      "block": { "type": "thing", "state": { "～": 2, "😀": 1 }, "refs": {} },
      "canonical": "{\"refs\":{},\"state\":{\"～\":2,\"😀\":1},\"type\":\"thing\"}" },
    { "name": "the one form: empty state and refs are written {} and kept (canonical.md, Edge cases)",
      "block": { "type": "thing", "state": {}, "refs": {} },
      "canonical": "{\"refs\":{},\"state\":{},\"type\":\"thing\"}" },
    { "name": "the one form: an empty array in state is written [] and kept",
      "block": { "type": "thing", "state": { "a": [] }, "refs": {} },
      "canonical": "{\"refs\":{},\"state\":{\"a\":[]},\"type\":\"thing\"}" },
    { "name": "the one form: an empty object inside state is written {} and kept, never dropped",
      "block": { "type": "thing", "state": { "x": {} }, "refs": {} },
      "not_same_as": { "type": "thing", "state": {}, "refs": {} },
      "canonical": "{\"refs\":{},\"state\":{\"x\":{}},\"type\":\"thing\"}" },
    { "name": "the one form: an empty string is written \"\" and kept",
      "block": { "type": "thing", "state": { "s": "" }, "refs": {} },
      "not_same_as": { "type": "thing", "state": {}, "refs": {} },
      "canonical": "{\"refs\":{},\"state\":{\"s\":\"\"},\"type\":\"thing\"}" },
    { "name": "an empty set is canonical, written [] and kept; read refuses it (grammar)",
      "block": { "type": "thing", "state": { "seq": 1, "audience": "public" }, "refs": { "author": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "prev": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "sees": [] } },
      "not_same_as": { "type": "thing", "state": { "seq": 1, "audience": "public" }, "refs": { "author": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "prev": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
      "canonical_contains": "\"sees\":[]",
      "refused": ["grammar"] },
    { "name": "the one form: a shorter key before a longer key it begins (a, ab, b)",
      "block": { "type": "thing", "state": { "b": 1, "ab": 2, "a": 3 }, "refs": {} },
      "canonical": "{\"refs\":{},\"state\":{\"a\":3,\"ab\":2,\"b\":1},\"type\":\"thing\"}" },
    { "name": "the one form: zero is 0, and the least and greatest whole numbers are plain digits",
      "block": { "type": "thing", "state": { "z": 0, "max": 9007199254740991, "min": -9007199254740991 }, "refs": {} },
      "canonical": "{\"refs\":{},\"state\":{\"max\":9007199254740991,\"min\":-9007199254740991,\"z\":0},\"type\":\"thing\"}" },
    { "name": "the one form: each string escape is written one way: \\\" and \\\\, \\b \\t \\n \\f \\r, any other character below U+0020 as \\u00 and two lowercase hex digits; /, U+007F and é as themselves",
      "block": { "type": "thing", "state": { "s": "\"\\/\b\t\n\f\r\u0000\u001f\u007fé" }, "refs": {} },
      "canonical": "{\"refs\":{},\"state\":{\"s\":\"\\\"\\\\/\\b\\t\\n\\f\\r\\u0000\\u001f\u007fé\"},\"type\":\"thing\"}" }
  ]
}
