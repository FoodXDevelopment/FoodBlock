CAMERA_MODE=usb          # usb or esp32
ESP32_URL=http://esp32-cam.local/capture
VISION_BACKEND=ollama    # ollama (free, local) or claude
ANTHROPIC_API_KEY=       # only needed if VISION_BACKEND=claude
CAPTURE_INTERVAL=300000  # ms between captures (default 5 min)
FOODBLOCK_SERVER=        # optional, URL of FoodBlock server to sync blocks
