{
  "name": "foodblock-mcp",
  "version": "1.7.0",
  "description": "MCP server for the FoodBlock 1.7 protocol: any AI agent reads and writes signed FoodBlocks",
  "type": "module",
  "main": "server.js",
  "bin": {
    "foodblock-mcp": "./server.js"
  },
  "files": [
    "server.js",
    "door.js",
    "remote.js",
    "auth.js",
    "hosted.js",
    "store.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "node -e \"const p=require('./package.json');const bad=Object.entries({...p.dependencies,...p.optionalDependencies}).filter(([,v])=>/^(file|link|git|https?):/.test(v));if(bad.length){console.error('refusing to publish with local dependencies: '+bad.map(([k,v])=>k+'@'+v).join(', '));process.exit(1)}\""
  },
  "keywords": [
    "mcp",
    "foodblock",
    "food",
    "provenance",
    "ai",
    "agent",
    "model-context-protocol",
    "openai",
    "chatgpt",
    "claude",
    "cursor",
    "gemini",
    "windsurf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FoodXDevelopment/FoodBlock.git",
    "directory": "mcp"
  },
  "mcpName": "io.github.FoodXDevelopment/foodblock-mcp",
  "homepage": "https://foodx.network",
  "author": "FoodX <developers@foodx.com>",
  "dependencies": {
    "@foodxdev/foodblock": "file:../sdk/javascript",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/FoodXDevelopment/FoodBlock/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
