cbor_encode_push(blocks:blocks, short:bool?) -> text !
cbor_decode_push(hex:text) -> blocks !
cbor_encode_header(header:block, short:bool?) -> text !
cbor_decode_header(hex:text) -> block !
hash(type:text, state:json, refs:json, suite:suite?) -> text !
id_of(block:block, held:blocks?) -> text
hash_hex(text:text) -> text
hash_in(text:text, suite:suite?) -> text
create(type:text, state:json, refs:json, suite:suite?) -> block !
keypair(seed:text?, suite:suite?) -> object !
