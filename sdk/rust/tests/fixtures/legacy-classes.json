{
  "about": "Old values the converter puts in their 1.6 grammar (spec/legacy/converter.md, Values). Each case: the old state of a block as read, and the state reshape() must give.",
  "cases": [
    { "name": "time with an offset and no milliseconds", "state": { "at": "2026-09-24T17:55:24+02:00" }, "becomes": { "at": "2026-09-24T15:55:24.000Z" } },
    { "name": "time with a space and a short fraction", "state": { "when": "2026-09-24 17:55:24.5" }, "becomes": { "when": "2026-09-24T17:55:24.500Z" } },
    { "name": "time as seconds since the epoch", "state": { "when": 1790000000 }, "becomes": { "when": "2026-09-21T14:13:20.000Z" } },
    { "name": "time as milliseconds since the epoch", "state": { "when": 1790000000123 }, "becomes": { "when": "2026-09-21T14:13:20.123Z" } },
    { "name": "a time field nested in terms", "state": { "terms": { "deliver_by": "2026-09-26T10:48:30Z", "expires": "2026-09-27" } }, "becomes": { "terms": { "deliver_by": "2026-09-26T10:48:30.000Z", "expires": "2026-09-27T00:00:00.000Z" } } },
    { "name": "a date field", "state": { "use_by": "2026-10-01T09:00:00Z" }, "becomes": { "use_by": "2026-10-01" } },
    { "name": "a whole confidence", "state": { "confidence": 1 }, "becomes": { "confidence": "1" } },
    { "name": "a fractional confidence", "state": { "confidence": 0.8 }, "becomes": { "confidence": "0.8" } },
    { "name": "a confidence as numeric text", "state": { "confidence": "0.25" }, "becomes": { "confidence": "0.25" } },
    { "name": "a confidence that is a label has no 1.6 home", "state": { "confidence": "verified" }, "becomes": { "was_confidence": "verified" } },
    { "name": "a confidence above 1 has no 1.6 home", "state": { "confidence": 7 }, "becomes": { "was_confidence": 7 } },
    { "name": "a decimal is a string", "state": { "weight": 1.5, "n": 3.0, "big": 12345678901234567000.0 }, "becomes": { "weight": "1.5", "n": 3, "big": "12345678901234567000" } }
  ]
}
