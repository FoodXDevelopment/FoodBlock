  "types_dotted": "A type name with no row in `types`, written `base.rest`, where `base` is a 1.6 type or a `types` row that is not retired, reads as `base` reads, with state.kind `rest` (everything after the first dot) unless the block already has a state.kind. `observe.whatever` reads as type `observe`, kind `whatever`. A type row's `kind` likewise never overwrites a state.kind the block has. Applied in the `types` step, after the rows.",
  "shapes": {
    "promise": [
      {
        "refs": {
          "seller": "from",
          "buyer": "to",
          "need": "for"
        },
        "move": {
          "state.due": "state.terms.deliver_by",
          "state.terms.due": "state.terms.deliver_by"
        }
      },
      {
        "when": {
