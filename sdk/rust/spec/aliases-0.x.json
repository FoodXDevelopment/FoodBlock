        },
        "force": true
      },
      {
        "when": {
          "state.last_good": "*"
        },
        "move": {
          "state.last_good": "state.counted_to"
        }
      },
      {
        "when": {
          "state.last_counted": "*"
        },
        "move": {
          "state.last_counted": "state.counted_to"
        }
      }
    ],
    "grant.member": [
