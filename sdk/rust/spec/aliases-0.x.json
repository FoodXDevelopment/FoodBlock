        },
        "set": {
          "state.status": "withdrawn"
        },
        "force": true
      },
      {
        "when": {
          "state.status": "delivered",
          "refs.updates": "*"
        },
        "settles": "updates",
        "set": {
          "state.status": "accepted"
        },
        "force": true
      },
      {
