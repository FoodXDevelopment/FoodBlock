{
  "name": "@foodxdev/foodblock",
  "version": "1.6.0",
  "description": "SDK for the FoodBlock protocol — a content-addressable primitive for universal food data",
  "main": "src/index.cjs",
  "exports": {
    ".": "./src/index.cjs"
  },
  "files": [
    "src/",
    "core/",
    "spec/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node ../../spec/run-vectors.cjs && node ../../spec/oracle/run.cjs && node --test test/*.test.cjs",
    "build:wasm": "node scripts/build-wasm.cjs",
    "fuzz:build": "cargo build --release --manifest-path ../../tools/fuzz/Cargo.toml",
    "fuzz:vectors": "node ../../tools/fuzz/run-vectors.cjs",
    "fuzz:diff": "node ../../tools/fuzz/diff.cjs --seeds 1-25 --baseline ../../tools/fuzz/known.json",
    "fuzz:smoke": "npm run fuzz:build && ../../tools/fuzz/target/release/fbfuzz run 1 60 && npm run fuzz:vectors && npm run fuzz:diff",
    "sim": "cargo run --release --manifest-path ../../tools/sim/Cargo.toml -- run --seeds 1-30 --peers 12 --steps 20 --jobs 4"
  },
  "keywords": [
    "food",
    "foodblock",
    "protocol",
    "traceability",
    "provenance",
    "supply-chain",
    "content-addressable",
    "foodx"
  ],
  "license": "MIT",
  "author": "FoodX <developers@foodx.com>",
  "homepage": "https://www.foodx.network/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FoodXDevelopment/FoodBlock.git",
    "directory": "sdk/javascript"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/FoodXDevelopment/FoodBlock/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
